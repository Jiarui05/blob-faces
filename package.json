{
  "name": "blob-faces",
  "version": "0.1.0",
  "description": "Assemble cute, animated blob characters from code. Tiny, zero-dependency SVG generator + playground.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "svg",
    "avatar",
    "emoji",
    "character",
    "generative",
    "kawaii",
    "animation"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./faces.css": "./dist/core/faces.css",
    "./audio": {
      "types": "./dist/audio/chiptune.d.ts",
      "import": "./dist/audio/chiptune.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "./src/core/index.ts",
    "./src/core/moods.ts",
    "./src/core/parts/*.ts",
    "./dist/core/index.js",
    "./dist/core/moods.js",
    "./dist/core/parts/*.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:site",
    "build:lib": "rm -rf dist && tsc -p tsconfig.build.json && cp src/core/faces.css dist/core/faces.css",
    "build:site": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:lib",
    "assets": "npm run build:lib && node scripts/make-assets.mjs"
  },
  "devDependencies": {
    "@fontsource/caveat-brush": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiarui05/blob-faces.git"
  },
  "homepage": "https://blob-face.jiarui.ink",
  "bugs": {
    "url": "https://github.com/Jiarui05/blob-faces/issues"
  }
}
